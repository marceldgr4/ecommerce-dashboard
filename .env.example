# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - E-COMMERCE DASHBOARD
# Copia este archivo a `.env` y ajusta los valores para tu entorno local o producción:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=ecommerce_db
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=dashboard_pass
POSTGRES_HOST_PORT=5433

# --- Backend Spring Boot & JWT ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=dashboard_user
SPRING_DATASOURCE_PASSWORD=dashboard_pass
# Clave HMAC-SHA256 codificada en Base64 (mínimo 256 bits / 32 bytes)
JWT_SECRET=31ZeHd6H785gYe3tDoVl8TNDBCEfBTdpQAQvO4zMEKY=
# Tiempo de expiración del token JWT en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION=86400000

# --- Frontend Web ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api

# --- pgAdmin 4 Administration Console ---
PGADMIN_DEFAULT_EMAIL=admin@dashboard.com
PGADMIN_DEFAULT_PASSWORD=Admin123!
PGADMIN_PORT=5050
